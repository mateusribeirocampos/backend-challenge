# Local development only. Every value here is a dummy for the docker compose containers.
# Copy to .env (bun loads it automatically): cp .env.example .env

PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=wagering
DATABASE_PASSWORD=wagering
DATABASE_NAME=wagering
# Connection pool of each app instance.
DATABASE_POOL_SIZE=10
# Longest wait for a free connection; past it the request fails as transient (HTTP 503, SQS retry).
DATABASE_POOL_ACQUIRE_TIMEOUT_MS=2000

# SQS emulator (MiniStack). It accepts any credentials; test/test is the usual local convention.
# Leave SQS_ENDPOINT and the keys empty to use real AWS and the SDK default credential chain.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
# Deadlines of every SQS call (connect, whole request). ReceiveMessage gets the wait time on top.
SQS_CONNECTION_TIMEOUT_MS=3000
SQS_REQUEST_TIMEOUT_MS=5000

# SQS consumer of wager-transactions.fifo, inside the app process.
SQS_CONSUMER_ENABLED=true
SQS_CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
SQS_CONSUMER_WAIT_TIME_SECONDS=10
# Must be greater than the wait time: on SIGTERM the consumer waits for the poll in progress.
SQS_CONSUMER_SHUTDOWN_TIMEOUT_SECONDS=15
# Transient failure n waits between half and all of min(max, base * 2^(n-1)) seconds.
SQS_CONSUMER_RETRY_BASE_SECONDS=5
SQS_CONSUMER_RETRY_MAX_SECONDS=300

# Currencies the platform operates (comma separated ISO-4217). A wallet can only be opened in one of them.
SUPPORTED_CURRENCIES=BRL

# Outbox publisher (inside every app instance): sends the outbox events to this FIFO queue.
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_BATCH_SIZE=20
# A claim reserves its events for this long; another instance takes them only after it. Longer than the send timeout.
OUTBOX_PUBLISHER_LEASE_SECONDS=30
OUTBOX_PUBLISHER_SEND_TIMEOUT_MS=5000
OUTBOX_PUBLISHER_POLL_INTERVAL_MS=500

# PENDING_REFERENCE worker (inside every app instance): checks again a REFUND/ROLLBACK that arrived before its reference.
# Check n waits between half and all of min(max, base * 2^(n-1)) ms. On the last check, a reference that does not
# exist rejects with REFERENCE_NOT_FOUND; one that exists but has not finished keeps it waiting. 15 checks: about 4.5 to 9 min.
PENDING_REFERENCE_WORKER_ENABLED=true
PENDING_REFERENCE_MAX_ATTEMPTS=15
PENDING_REFERENCE_BASE_DELAY_MS=1000
PENDING_REFERENCE_MAX_DELAY_MS=60000
PENDING_REFERENCE_BATCH_SIZE=20
PENDING_REFERENCE_POLL_INTERVAL_MS=500
